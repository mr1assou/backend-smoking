// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id            Int     @id @default(autoincrement())
  email              String  @unique
  password           String
  hashedRefreshToken String?

  quitReasons       String[] @default([])  
  motivation        String?
  priorQuitAttempts String?
  primaryInterests  String[] @default([])

  username       String?
  sex            String?
  country        String?
  countryFlag    String?
  currency       String?
  quitDatePreset String?
  quitDate       DateTime? @db.Timestamptz(3)
  streakStart    DateTime? @db.Timestamptz(3)

  cigarettesPerDay     Int?
  cigarettesPerDayNote String?
  packPrice            String?
  yearsSmoking         String?
  cigarettesPerPack    Int?

  timezone String?
  motivationCardIndex Int @default(0) @map("motivation_card_index")
  tipsCardIndex       Int @default(0) @map("tips_card_index")
  image_url String?
  last_offline_at DateTime? @map("last_offline_at") @db.Timestamptz(3)
  freedomPoints Int @default(0) @map("freedom_points")

  slipEvents   SlipEvent[]
  quitAttempts QuitAttempt[]
  posts        Post[]
  postComments      PostComment[]
  postVotes         PostVote[]
  postCommentVotes  PostCommentVote[]
  commentRepliesTo  PostComment[] @relation("CommentReplyTo")

  chatThreadsAsUserOne ChatThread[] @relation("ChatThreadUserOne")
  chatThreadsAsUserTwo ChatThread[] @relation("ChatThreadUserTwo")
  chatMessages         ChatMessage[]
  chatThreadReads      ChatThreadRead[]
  badges               UserBadge[]
  freedomPointLedger   FreedomPointLedger[]
  goals                UserGoal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// Immutable record of FP earned (aggregate cached on `users.freedom_points`).
model FreedomPointLedger {
  ledger_id   Int      @id @default(autoincrement())
  user_id     Int      @map("user_id")
  user        User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  amount      Int
  source_type String   @map("source_type")
  source_key  String   @map("source_key")
  earned_at   DateTime @default(now()) @map("earned_at") @db.Timestamptz(3)

  @@unique([user_id, source_type, source_key])
  @@index([user_id, earned_at(sort: Desc)])
  @@map("freedom_point_ledger")
}

model QuitAttempt {
  attempt_id           Int       @id @default(autoincrement())
  user_id              Int
  user                 User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  attemptNumber        Int       @map("attempt_number")
  startedAt            DateTime  @map("started_at") @db.Timestamptz(3)
  endedAt              DateTime? @map("ended_at") @db.Timestamptz(3)
  endOutcome           String?   @map("end_outcome")
  durationSeconds      Int       @default(0) @map("duration_seconds")
  cigarettesAvoided    Int       @default(0) @map("cigarettes_avoided")
  moneySaved           Float     @default(0) @map("money_saved")
  lifeMinutesGained    Int       @default(0) @map("life_minutes_gained")
  slipCigarettesSmoked Int       @default(0) @map("slip_cigarettes_smoked")
  closingSlipEvent     SlipEvent?
  goals                UserGoal[]

  @@unique([user_id, attemptNumber])
  @@map("quit_attempts")
}

model UserGoal {
  goal_id               Int       @id @default(autoincrement())
  user_id               Int       @map("user_id")
  attempt_id            Int       @map("attempt_id")
  type                  String
  target                Float
  baseline_progress     Float     @default(0) @map("baseline_progress")
  status                String    @default("active")
  started_at            DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  completed_at          DateTime? @map("completed_at") @db.Timestamptz(3)
  failed_at             DateTime? @map("failed_at") @db.Timestamptz(3)
  failed_reason         String?   @map("failed_reason")
  failed_by_slip_event_id Int?    @map("failed_by_slip_event_id")

  user    User        @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  attempt QuitAttempt @relation(fields: [attempt_id], references: [attempt_id], onDelete: Cascade)

  @@unique([attempt_id, type])
  @@index([user_id, status])
  @@map("user_goals")
}

model SlipEvent {
  slip_event_id       Int       @id @default(autoincrement())
  user_id             Int
  user                User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  outcome             String
  cigarettesCount     Int?
  previousStreakStart DateTime? @db.Timestamptz(3)
  previousQuitDate    DateTime? @map("previous_quit_date") @db.Timestamptz(3)
  closedAttemptId     Int?      @unique @map("closed_attempt_id")
  closedAttempt       QuitAttempt? @relation(fields: [closedAttemptId], references: [attempt_id], onDelete: SetNull)
  newAttemptId        Int?      @map("new_attempt_id")
  loggedAt            DateTime  @default(now()) @db.Timestamptz(3)

  @@index([user_id, loggedAt])

  @@map("slip_events")
}

model Post {
  post_id        Int      @id @default(autoincrement())
  author_id      Int
  author         User     @relation(fields: [author_id], references: [user_id], onDelete: Cascade)

  title          String
  description    String   @default("")
  tag_id         String?

  image_url      String?
  image_frame    String?
  image_crop     Json?

  upvote_count   Int      @default(0)
  downvote_count Int      @default(0)
  share_count    Int      @default(0)
  comment_count  Int      @default(0)

  comments       PostComment[]
  votes          PostVote[]

  created_at     DateTime @default(now()) @db.Timestamptz(3)
  updated_at     DateTime @updatedAt @db.Timestamptz(3)

  @@index([created_at(sort: Desc)])
  @@index([author_id, created_at(sort: Desc)])
  @@map("posts")
}

model PostComment {
  comment_id  Int      @id @default(autoincrement())
  post_id     Int
  post        Post     @relation(fields: [post_id], references: [post_id], onDelete: Cascade)
  author_id   Int
  author      User     @relation(fields: [author_id], references: [user_id], onDelete: Cascade)

  parent_comment_id Int?
  parent_comment    PostComment?  @relation("CommentReplies", fields: [parent_comment_id], references: [comment_id], onDelete: Cascade)
  replies           PostComment[] @relation("CommentReplies")

  reply_to_user_id Int?
  reply_to_user    User? @relation("CommentReplyTo", fields: [reply_to_user_id], references: [user_id], onDelete: SetNull)

  text           String
  upvote_count   Int      @default(0)
  downvote_count Int      @default(0)

  votes PostCommentVote[]

  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)

  @@index([post_id, created_at(sort: Asc)])
  @@index([post_id, parent_comment_id, created_at(sort: Asc)])
  @@index([author_id])
  @@map("post_comments")
}

model PostCommentVote {
  comment_vote_id Int         @id @default(autoincrement())
  comment_id      Int
  comment         PostComment @relation(fields: [comment_id], references: [comment_id], onDelete: Cascade)
  user_id         Int
  user            User        @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  vote         String

  created_at   DateTime @default(now()) @db.Timestamptz(3)
  updated_at   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([comment_id, user_id])
  @@index([user_id])
  @@map("post_comment_votes")
}

model PostVote {
  post_vote_id Int      @id @default(autoincrement())
  post_id      Int
  post         Post     @relation(fields: [post_id], references: [post_id], onDelete: Cascade)
  user_id      Int
  user         User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  vote         String

  created_at   DateTime @default(now()) @db.Timestamptz(3)
  updated_at   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([post_id, user_id])
  @@index([user_id])
  @@map("post_votes")
}

/// One 1:1 conversation between two users (user_one_id is always the lower user_id).
model ChatThread {
  thread_id   Int      @id @default(autoincrement())
  user_one_id Int      @map("user_one_id")
  user_two_id Int      @map("user_two_id")
  userOne     User     @relation("ChatThreadUserOne", fields: [user_one_id], references: [user_id], onDelete: Cascade)
  userTwo     User     @relation("ChatThreadUserTwo", fields: [user_two_id], references: [user_id], onDelete: Cascade)

  messages    ChatMessage[]
  reads       ChatThreadRead[]

  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)

  @@unique([user_one_id, user_two_id])
  @@index([user_one_id])
  @@index([user_two_id])
  @@index([user_one_id, updated_at(sort: Desc)])
  @@index([user_two_id, updated_at(sort: Desc)])
  @@map("chat_threads")
}

model ChatMessage {
  message_id        Int        @id @default(autoincrement())
  thread_id         Int        @map("thread_id")
  thread            ChatThread @relation(fields: [thread_id], references: [thread_id], onDelete: Cascade)
  sender_id         Int        @map("sender_id")
  sender            User       @relation(fields: [sender_id], references: [user_id], onDelete: Cascade)

  /// text | image | video | audio
  message_type      String     @default("text") @map("message_type")
  /// Text body or optional caption on media messages.
  text              String?
  /// Public R2 URL for image, video, or audio payloads.
  media_url         String?    @map("media_url")
  /// MIME type of the R2 object (e.g. image/jpeg, video/mp4, audio/m4a).
  media_mime_type   String?    @map("media_mime_type")
  /// Playback length for audio/video (milliseconds).
  media_duration_ms Int?       @map("media_duration_ms")
  /// Uploaded file size in bytes.
  media_size_bytes  Int?       @map("media_size_bytes")

  created_at        DateTime   @default(now()) @db.Timestamptz(3)

  /// Paginate messages in a thread (newest first).
  @@index([thread_id, created_at(sort: Desc)])
  /// Count unread messages per thread for a recipient.
  @@index([thread_id, sender_id, created_at(sort: Desc)])
  @@index([sender_id])
  @@index([message_type])
  @@map("chat_messages")
}

/// Per-user read cursor in a thread — drives seen/unseen for both sides.
model ChatThreadRead {
  thread_read_id Int        @id @default(autoincrement())
  thread_id      Int        @map("thread_id")
  thread         ChatThread @relation(fields: [thread_id], references: [thread_id], onDelete: Cascade)
  user_id        Int        @map("user_id")
  user           User       @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  /// UTC instant of the last message this user has read in the thread.
  last_read_at   DateTime   @default(now()) @map("last_read_at") @db.Timestamptz(3)

  @@unique([thread_id, user_id])
  @@index([user_id])
  @@map("chat_thread_reads")
}

/// Badges a user has earned (e.g. first-step on signup).
model UserBadge {
  user_badge_id Int      @id @default(autoincrement())
  user_id       Int      @map("user_id")
  user          User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  badge_id      String   @map("badge_id")
  earned_at     DateTime @default(now()) @map("earned_at") @db.Timestamptz(3)

  @@unique([user_id, badge_id])
  @@index([user_id])
  @@map("user_badges")
}

/// Curated relax-sound tracks — audio stored in R2 under `music/{slug}/`; covers bundled in the app.
model RelaxSound {
  sound_id        Int      @id @default(autoincrement())
  slug            String   @unique
  label           String
  description     String   @default("")
  audio_url       String   @map("audio_url")
  audio_mime_type String   @map("audio_mime_type")
  duration_ms     Int?     @map("duration_ms")
  size_bytes      Int?     @map("size_bytes")
  sort_order      Int      @default(0) @map("sort_order")
  is_active       Boolean  @default(true) @map("is_active")
  created_at      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updated_at      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([is_active, sort_order])
  @@map("relax_sounds")
}
