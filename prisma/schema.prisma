// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Énumérations ---

enum UserRole {
  ADMIN
  AUDITOR
}

enum AssetStatus {
  GOOD
  DAMAGED
  REPAIR
  BROKEN
  TO_REPLACE
}

enum LocationType {
  HOTEL
  FLOOR
  ZONE
  SUBZONE
}

enum AlertType {
  DAMAGED
  BROKEN
  REPAIR
  REPLACE
  NOT_SCANNED
  MOVEMENT
}

enum AlertStatus {
  OPEN
  RESOLVED
}

enum TagClassification {
  EXPECTED
  UNEXPECTED
  UNKNOWN
}

// --- Modèles ---

model User {
  id                 String         @id @default(uuid()) @db.Uuid
  name               String
  email              String         @unique
  password           String
  role               UserRole       @default(AUDITOR)
  created_at         DateTime       @default(now())
  hashedRefreshToken String?
  
  scans              Scan[]
  reports            Report[]
  history            AssetHistory[]
  movements          AssetMovement[]
  inventorySessions  InventorySession[]

  @@map("users")
}

model Asset {
  id            String       @id @default(uuid()) @db.Uuid
  tag_id        String?      @unique
  name          String
  category_id   String       @db.Uuid
  brand         String
  model         String
  supplier_id   String       @db.Uuid
  purchase_date DateTime
  price         Decimal      @db.Decimal(10, 2)
  warranty_end  DateTime?
  location_id   String       @db.Uuid
  status        AssetStatus  @default(GOOD)
  created_at    DateTime     @default(now())
  image_url     String?      @db.Text

  category      Category     @relation(fields: [category_id], references: [id])
  supplier      Supplier     @relation(fields: [supplier_id], references: [id])
  location      Location     @relation(fields: [location_id], references: [id])
  
  scans         Scan[]
  alerts        Alert[]
  history       AssetHistory[]
  movements     AssetMovement[]
  inventoryTags InventoryTag[]

  @@map("assets")
}

model Location {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  parent_id String?      @db.Uuid
  type      LocationType

  parent    Location?    @relation("LocationHierarchy", fields: [parent_id], references: [id])
  children  Location[]   @relation("LocationHierarchy")
  
  assets    Asset[]
  scans     Scan[]
  alerts    Alert[]
  movements AssetMovement[] @relation("ToLocation")
  from_movements AssetMovement[] @relation("FromLocation")
  inventorySessions InventorySession[]

  @@map("locations")
}

model Category {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @unique
  assets Asset[]

  @@map("categories")
}

model Supplier {
  id            String  @id @default(uuid()) @db.Uuid
  name          String
  contact_email String?
  phone         String?
  assets        Asset[]

  @@map("suppliers")
}

model Scan {
  id          String      @id @default(uuid()) @db.Uuid
  asset_id    String      @db.Uuid
  user_id     String      @db.Uuid
  location_id String      @db.Uuid
  status      AssetStatus
  scanned_at  DateTime    @default(now())

  asset       Asset       @relation(fields: [asset_id], references: [id])
  user        User        @relation(fields: [user_id], references: [id])
  location    Location    @relation(fields: [location_id], references: [id])
  movements   AssetMovement[]

  @@map("scans")
}

model Alert {
  id          String      @id @default(uuid()) @db.Uuid
  asset_id    String?     @db.Uuid
  location_id String?     @db.Uuid
  type        AlertType
  status      AlertStatus @default(OPEN)
  created_at  DateTime    @default(now())

  comment     String?     // Stocke le texte du constat
  photo_url   String?     @map("image_url")

  asset       Asset?      @relation(fields: [asset_id], references: [id])
  location    Location?   @relation(fields: [location_id], references: [id])

  @@map("alerts")
}

model Report {
  id           String   @id @default(uuid()) @db.Uuid
  generated_by String   @db.Uuid
  report_type  String
  filters      Json?
  created_at   DateTime @default(now())

  user         User     @relation(fields: [generated_by], references: [id])

  @@map("reports")
}

model AssetHistory {
  id         String   @id @default(uuid()) @db.Uuid
  asset_id   String   @db.Uuid
  action     String
  user_id    String   @db.Uuid
  timestamp  DateTime @default(now())

  asset      Asset    @relation(fields: [asset_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id])

  @@map("asset_history")
}

model AssetMovement {
  id               String   @id @default(uuid()) @db.Uuid
  asset_id         String   @db.Uuid
  from_location_id String?  @db.Uuid
  to_location_id   String   @db.Uuid
  user_id          String   @db.Uuid
  scan_id          String?  @db.Uuid
  session_id       String?  @db.Uuid
  moved_at         DateTime @default(now())

  asset            Asset    @relation(fields: [asset_id], references: [id])
  from_location    Location? @relation("FromLocation", fields: [from_location_id], references: [id])
  to_location      Location  @relation("ToLocation", fields: [to_location_id], references: [id])
  user             User      @relation(fields: [user_id], references: [id])
  scan             Scan?     @relation(fields: [scan_id], references: [id])
  session          InventorySession? @relation(fields: [session_id], references: [id])

  @@index([session_id])
  @@map("asset_movements")
}

// --- Inventory Session & Tags ---

model InventorySession {
  id               String    @id @default(uuid()) @db.Uuid
  user_id          String    @db.Uuid
  location_id      String    @db.Uuid
  started_at       DateTime  @default(now())
  ended_at         DateTime?
  last_scan_at     DateTime?

  // Counters — computed on session close
  total_scanned    Int       @default(0)
  total_expected   Int       @default(0)
  found_count      Int       @default(0)
  missing_count    Int       @default(0)
  unexpected_count Int       @default(0)
  unknown_count    Int       @default(0)
  movement_count   Int       @default(0)

  user             User      @relation(fields: [user_id], references: [id])
  location         Location  @relation(fields: [location_id], references: [id])
  tags             InventoryTag[]
  movements        AssetMovement[]

  @@index([user_id])
  @@index([location_id])
  @@index([started_at(sort: Desc)])
  @@map("inventory_sessions")
}

model InventoryTag {
  id              String            @id @default(uuid()) @db.Uuid
  session_id      String            @db.Uuid
  epc_code        String
  asset_id        String?           @db.Uuid
  classification  TagClassification
  rssi            Int?
  scanned_at      DateTime          @default(now())

  session         InventorySession  @relation(fields: [session_id], references: [id], onDelete: Cascade)
  asset           Asset?            @relation(fields: [asset_id], references: [id])

  @@unique([session_id, epc_code])
  @@index([session_id])
  @@index([asset_id])
  @@index([classification])
  @@map("inventory_tags")
}
